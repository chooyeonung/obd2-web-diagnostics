@page "/"
@using ObdWebApp.Models
@using ObdWebApp.ViewModels
@inject DashboardViewModel Vm
@implements IDisposable

<PageTitle>OBD-II 웹 진단</PageTitle>

@* ---------- 연결 패널 ---------- *@
<section class="panel">
    <div class="connect-row">
        <label><input type="radio" name="tp" checked="@(Vm.Kind == TransportKind.Simulator)"
                      @onchange="@(() => Vm.Kind = TransportKind.Simulator)" disabled="@Vm.IsConnected" /> 시뮬레이터 (가상 ECU)</label>
        <label><input type="radio" name="tp" checked="@(Vm.Kind == TransportKind.Ble)"
                      @onchange="@(() => Vm.Kind = TransportKind.Ble)" disabled="@Vm.IsConnected" /> vLinker / ELM327 (BLE)</label>
        <label><input type="radio" name="tp" checked="@(Vm.Kind == TransportKind.WebSocket)"
                      @onchange="@(() => Vm.Kind = TransportKind.WebSocket)" disabled="@Vm.IsConnected" /> 자작 보드 (WiFi/WebSocket)</label>
        @if (Vm.Kind == TransportKind.WebSocket && !Vm.IsConnected)
        {
            <input class="ws-url" @bind="Vm.WsUrl" placeholder="ws://192.168.4.1/ws" />
        }

        @if (!Vm.IsConnected)
        {
            <button class="btn primary" @onclick="Vm.ConnectAsync" disabled="@Vm.IsBusy">
                @(Vm.IsBusy ? "연결 중..." : "연결")
            </button>
        }
        else
        {
            <span class="status ok">● @Vm.TransportName</span>
            @if (Vm.Vin is not null) { <span class="vin">VIN: @Vm.Vin</span> }
            <button class="btn" @onclick="Vm.DisconnectAsync">연결 해제</button>
        }
    </div>
    @if (Vm.Error is not null) { <p class="error">@Vm.Error</p> }
</section>

@* ---------- 실시간 게이지 ---------- *@
<section class="panel">
    <h2>실시간 데이터</h2>
    <div class="gauges">
        @foreach (var pid in DashboardViewModel.DashboardPids)
        {
            var def = PidDefinitions.Mode01[pid];
            var val = Vm.Snapshot?.Get(pid);
            <div class="gauge">
                <div class="gauge-name">@def.Name</div>
                <div class="gauge-value">@(val is null ? "—" : DashboardViewModel.FormatValue(pid, val.Value))</div>
                <div class="gauge-unit">@def.Unit</div>
            </div>
        }
    </div>
    @if (Vm.IsConnected)
    {
        <p class="hint">@(Vm.IsPolling ? $"폴링 중 · 주기 {DashboardViewModel.PollIntervalMs}ms" : "폴링 대기")</p>
    }
</section>

@* ---------- 고장코드 ---------- *@
<section class="panel">
    <h2>고장코드 (DTC)</h2>
    <div class="dtc-actions">
        <button class="btn" @onclick="Vm.ReadDtcsAsync" disabled="@(!Vm.IsConnected || Vm.IsBusy)">조회</button>
        <button class="btn danger" @onclick="Vm.ClearDtcsCommandAsync" disabled="@(!Vm.CanClearDtcs)">
            @(Vm.ConfirmClear ? "정말 소거할까요? (다시 클릭)" : "소거")
        </button>
    </div>
    @if (Vm.Dtcs is null)
    {
        <p class="hint">조회 버튼을 눌러 저장된 고장코드를 읽습니다.</p>
    }
    else if (Vm.Dtcs.Count == 0)
    {
        <p class="ok-text">저장된 고장코드가 없습니다. ✓</p>
    }
    else
    {
        <table class="dtc-table">
            <thead><tr><th>코드</th><th>설명</th></tr></thead>
            <tbody>
                @foreach (var dtc in Vm.Dtcs)
                {
                    <tr><td class="dtc-code">@dtc.Code</td><td>@dtc.Description</td></tr>
                }
            </tbody>
        </table>
    }
</section>

@* ---------- 통신 로그 ---------- *@
<section class="panel">
    <h2>통신 로그 <button class="btn tiny" @onclick="Vm.ClearLog">지우기</button></h2>
    <pre class="log">@string.Join("\n", Vm.Log.TakeLast(30))</pre>
</section>

@code {
    protected override void OnInitialized() =>
        Vm.PropertyChanged += OnVmPropertyChanged;

    private void OnVmPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    public void Dispose() =>
        Vm.PropertyChanged -= OnVmPropertyChanged;
}
